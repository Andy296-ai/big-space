APP_NAME=Nodus
APP_ENV=local
APP_KEY=
# true — только для локальной разработки: иначе на каждой необработанной
# ошибке в проде светятся полные стектрейсы, пути и значения из .env.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# За reverse-proxy (nginx/Caddy — см. docs/PROJECT_OVERVIEW.md §11) задайте
# IP прокси (через запятую) или '*', если приложение и так недоступно напрямую —
# иначе HSTS и определение HTTPS-соединения работать не будут.
# TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — рекомендуемый вариант (лёгкий перенос между серверами через
# pg_dump/pg_restore, устойчив к параллельной записи под нагрузкой). Для
# быстрого локального пробного запуска можно оставить DB_CONNECTION=sqlite —
# остальные DB_*-переменные тогда не нужны, база — файл database/database.sqlite.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nodus
DB_USERNAME=nodus
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Единственная учётная запись приложения (логин = users.name).
# Задайте свой пароль перед запуском за пределами localhost.
# ROOT_EMAIL — куда приходит код двухфакторной аутентификации при входе root.
ROOT_USERNAME=root
ROOT_PASSWORD=
ROOT_EMAIL=

# Живые обновления графа через WebSocket (Laravel Reverb). `composer run dev`
# (php artisan dev) поднимает reverb:start сам — отдельно запускать не нужно,
# кроме продакшна, где это должен быть supervised-процесс. Значения ниже
# сгенерируйте заново через `php artisan reverb:install`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Сгенерировать: php artisan webpush:vapid (пишет публичный/приватный ключ сюда сам).
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
